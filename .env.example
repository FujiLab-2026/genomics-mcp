# ============================================================
# genomics-mcp 環境変数設定
# ============================================================
# このファイルを .env にコピーして、各自のAPIキーを設定してください。
# cp .env.example .env  (macOS/Linux)
# copy .env.example .env  (Windows)

# ----------------------------------------------------------
# PubMed (NCBI E-utilities) API Key
# ----------------------------------------------------------
# 無くても動作しますが、レートリミットが緩和されます（3 req/sec → 10 req/sec）
# 取得方法: https://www.ncbi.nlm.nih.gov/account/ でアカウント作成後、
#   Settings > API Key Management > Create an API Key
NCBI_API_KEY=

# ----------------------------------------------------------
# OncoKB API Token
# ----------------------------------------------------------
# OncoKBサーバーの利用に必須です
# 取得方法: https://www.oncokb.org/account/register で学術アカウント登録
#   ※ 登録時にAcademic licenseを選択（学術利用は無料）
#   ※ 承認まで1〜3営業日かかる場合があります
ONCOKB_TOKEN=
